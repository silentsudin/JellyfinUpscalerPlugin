# Jellyfin Upscaler Sidecar Service - Intel GPU (IPEX)
# Using Intel Extension for PyTorch for Intel GPU acceleration
FROM intel/intel-extension-for-pytorch:2.7.10-xpu-pip-base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    ca-certificates \
    gnupg \
    lsb-release \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    ffmpeg \
    libgl1-mesa-glx \
    libgl1-mesa-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libegl1-mesa \
    libgles2-mesa \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Set working directory
WORKDIR /app

# Copy Intel-specific requirements and install Python dependencies
COPY requirements-intel.txt .
RUN python3 -m pip install --no-cache-dir -r requirements-intel.txt || echo "Some packages failed, trying alternative installation..."

# Fallback: Install BasicSR and RealESRGAN from source if pip install failed
RUN python3 -c "import basicsr" 2>/dev/null || python3 -m pip install --no-cache-dir git+https://github.com/xinntao/BasicSR.git
RUN python3 -c "import realesrgan" 2>/dev/null || python3 -m pip install --no-cache-dir git+https://github.com/xinntao/Real-ESRGAN.git

# Debug: List installed packages and verify imports
RUN python3 -m pip list | grep -E "(basicsr|realesrgan|torch|intel)"
RUN python3 -c "import sys; print('Python path:', sys.path)"

# Copy application code
COPY src/ ./src/

# Copy config and models directories
COPY config/ ./config/
COPY models/ ./models/

# Create additional necessary directories
RUN mkdir -p /app/temp /app/output /app/logs /tmp/sycl_cache

# Verify Intel GPU is available and libraries can be imported
RUN python3 -c "import torch; import intel_extension_for_pytorch as ipex; print('Intel Extension for PyTorch available')" || echo "Intel GPU not available"
RUN python3 -c "import cv2; print('OpenCV available')" || echo "OpenCV not available"
RUN python3 -c "import basicsr; print('BasicSR available')" || echo "BasicSR not available"
RUN python3 -c "import realesrgan; print('RealESRGAN available')" || echo "RealESRGAN not available"

# Expose port for API
EXPOSE 8765

# Set environment variables for Intel GPU
ENV PYTHONPATH=/app
ENV UPSCALER_CONFIG_PATH=/app/config
ENV UPSCALER_MODEL_PATH=/app/models
ENV UPSCALER_TEMP_PATH=/app/temp
ENV UPSCALER_LOG_LEVEL=INFO
ENV UPSCALER_USE_INTEL_GPU=true
ENV UPSCALER_DEVICE_TYPE=xpu

# Intel GPU specific environment variables
ENV SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1
ENV SYCL_CACHE_PERSISTENT=1
ENV SYCL_CACHE_DIR=/tmp/sycl_cache
ENV ONEAPI_DEVICE_SELECTOR=level_zero:gpu

# PyTorch Intel GPU optimization
ENV TORCH_SHOW_CPP_STACKTRACES=1
ENV IPEX_TILE_AS_DEVICE=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Run the upscaler service
CMD ["python3", "-m", "src.main"]
