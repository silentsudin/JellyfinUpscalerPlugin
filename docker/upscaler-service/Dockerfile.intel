# Jellyfin Upscaler Sidecar Service - Intel GPU (IPEX)
# Using Intel Extension for PyTorch for Intel GPU acceleration
FROM intel/intel-extension-for-pytorch:2.1.10-xpu-pip-base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    ca-certificates \
    gnupg \
    lsb-release \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    ffmpeg \
    libgl1-mesa-glx \
    libgl1-mesa-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libegl1-mesa \
    libgles2-mesa \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Set working directory
WORKDIR /app

# Install Intel Extension for PyTorch and compatible versions
# Note: IPEX is already installed in the base image, but we may need specific versions
RUN python3 -m pip install intel-extension-for-pytorch==2.1.10+xpu --find-links https://pytorch-extension.intel.com/release-whl/stable/xpu/us/

# Copy Intel-specific requirements and install Python dependencies
COPY requirements-intel.txt .
RUN python3 -m pip install --no-cache-dir -r requirements-intel.txt

# Copy application code
COPY src/ ./src/

# Copy config and models directories
COPY config/ ./config/
COPY models/ ./models/

# Create additional necessary directories
RUN mkdir -p /app/temp /app/output /app/logs

# Expose port for API
EXPOSE 8765

# Set environment variables for Intel GPU
ENV PYTHONPATH=/app
ENV UPSCALER_CONFIG_PATH=/app/config
ENV UPSCALER_MODEL_PATH=/app/models
ENV UPSCALER_TEMP_PATH=/app/temp
ENV UPSCALER_LOG_LEVEL=INFO
ENV UPSCALER_USE_INTEL_GPU=true
ENV UPSCALER_DEVICE_TYPE=xpu

# Intel GPU specific environment variables
ENV SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1
ENV SYCL_CACHE_PERSISTENT=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Run the upscaler service
CMD ["python3", "-m", "src.main"]
