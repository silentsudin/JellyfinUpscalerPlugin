# Upscaler Service Configuration
# This file contains default configuration that can be overridden by environment variables

# Service settings
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8765

# Processing settings
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MINUTES=60
USE_GPU=true

# Model settings
DEFAULT_MODEL=RealESRGAN_x4plus
ENABLE_MODEL_DOWNLOAD=true

# Paths (will be overridden by environment variables in Docker)
MODEL_PATH=/app/models
TEMP_PATH=/app/temp
OUTPUT_PATH=/app/output
LOG_PATH=/app/logs
