# Docker ignore file for upscaler service

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
temp/
tmp/
*.tmp

# Large model files (these should be downloaded at runtime or mounted)
*.pth
*.bin
*.safetensors

# Test files
test_*
*_test.py

# Documentation
*.md
!README.md

# Git
.git/
.gitignore
